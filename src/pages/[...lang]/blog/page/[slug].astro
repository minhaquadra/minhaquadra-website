---
import Base from "@/layouts/Base.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import parseTomlToJson from "@/lib/utils/parseTomlToJson";
import { supportedLanguages } from "@/lib/utils/languageParser.ts";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const config = parseTomlToJson("./src/config/config.toml");
      const { blogFolder }: { blogFolder: "blog" } = config.settings;
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      const postIndex = await getEntryCTM(
        blogFolder,
        "-index",
        lang.languageCode,
      );

      const posts = await getCollectionCTM(blogFolder, lang.languageCode);
      const totalPages = Math.ceil(posts.length / config.settings.pagination);
      const paths = [];

      // If draft true in index.md file frontmatter don't include any page related to this page collection in production
      if (postIndex?.data.draft && import.meta.env.PROD) {
        return [];
      }

      // Disable page generation if config.settings.pagination is 0 or false
      if (config.settings.pagination === 0 || !config.settings.pagination) {
        return [];
      }

      for (let i = 1; i < totalPages; i++) {
        paths.push({
          params: {
            slug: (i + 1).toString(),
          },
        });
      }

      return paths.map((path) => ({
        params: {
          slug: path.params.slug,
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
        },
        props: {
          postIndex,
          pagination: config.settings.pagination,
          blogCollection: posts,
        },
      }));
    }),
  );

  return paths.flat();
}

const { slug } = Astro.params;
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;
let { postIndex } = Astro.props;
---

<Base {...postIndex?.data} fitToScreen={false}>

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="blog-hero">
    <div class="container">
      <div class="mx-auto max-w-7xl">
        <h1 data-aos="reveal-anim-left">
          <span class="text-display-5 md:text-display-4 leading-tight font-semibold blog-title-line1">Blog </span><span class="text-display-5 md:text-display-4 leading-tight font-semibold blog-title-line2">Minha Quadra.</span>
        </h1>
      </div>
    </div>
  </section>

  <!-- ── Blog content ──────────────────────────────────────────────── -->
  <div class="blog-content-bg">
    <BlogLayout
      pageType="list"
      sidebar={{
        enable: false,
        sticky: false,
      }}
      contentList={{
        options: {
          layout: "grid",
          columns: 3,
          appearance: "dark",
        },
        pagination: { enable: true, currentPage },
      }}
      content={{ ...postIndex, ...postIndex?.data }}
    />
  </div>

</Base>

<style is:global>
  /* ── Hero ─────────────────────────────────────────────────────────── */
  .blog-hero {
    background-color: #002d3c;
    padding-top: 8rem;
    padding-bottom: 2rem;
    padding-left: max(2rem, 6vw);
    padding-right: max(2rem, 6vw);
    overflow-x: hidden;
  }

  .blog-title-line1 {
    color: #f5f5f5;
  }

  .blog-title-line2 {
    color: #b4fa50;
  }

  /* ── Blog content background ─────────────────────────────────────── */
  .blog-content-bg {
    background-color: #002d3c;
    padding-bottom: 6rem;
  }

  /* Sobrescreve o padding-top global da section */
  .blog-content-bg section {
    padding-top: 2rem;
  }

  /* ── Grid de posts (4 colunas responsivas) ──────────────────────── */
  .blog-content-bg .blog-search-results {
    display: grid !important;
    grid-template-columns: 1fr;
    gap: 24px !important;
    padding: 0 20px;
    width: 100%;
  }
  @media (min-width: 480px) {
    .blog-content-bg .blog-search-results {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 768px) {
    .blog-content-bg .blog-search-results {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .blog-content-bg .blog-search-results {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ── Card de post ─────────────────────────────────────────────── */
  .blog-content-bg .blog-search-results > article {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(225, 255, 165, 0.1);
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
  }
  .blog-content-bg .blog-search-results > article:hover {
    transform: translateY(-4px);
    border-color: rgba(180, 250, 80, 0.4);
    background-color: rgba(255, 255, 255, 0.09);
  }

  /* Imagem de capa: aspect 16/9, cover, raio só no topo */
  .blog-content-bg .blog-search-results > article > div:first-child {
    aspect-ratio: 16 / 9;
    height: auto !important;
    border-radius: 0 !important;
    overflow: hidden;
  }
  .blog-content-bg .blog-search-results > article > div:first-child img {
    width: 100%;
    height: 100% !important;
    object-fit: cover;
  }

  /* Corpo do card */
  .blog-content-bg .blog-search-results > article > div:last-child {
    padding: 16px !important;
    padding-bottom: 16px !important;
    background-color: transparent !important;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Linha de data + categoria — discreta */
  .blog-content-bg .blog-search-results > article > div:last-child > div:first-child {
    margin-top: 0 !important;
    margin-bottom: 8px !important;
    padding-bottom: 0 !important;
    font-size: 0.8rem;
    color: rgba(245, 245, 245, 0.6);
    gap: 6px !important;
  }
  .blog-content-bg .blog-search-results > article > div:last-child > div:first-child a {
    color: rgba(245, 245, 245, 0.7);
    text-decoration: none;
  }
  .blog-content-bg .blog-search-results > article > div:last-child > div:first-child a:hover {
    color: #b4fa50;
  }

  /* Título — 1rem semibold, máx 2 linhas com ellipsis */
  .blog-content-bg .blog-search-results > article h2 {
    font-size: 1rem !important;
    font-weight: 600 !important;
    line-height: 1.35 !important;
    margin: 0 0 12px 0 !important;
    color: #f5f5f5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-content-bg .blog-search-results > article h2 a {
    color: inherit;
    text-decoration: none;
  }

  /* Esconde o botão "Read more" (o card inteiro já é clicável via stretched-link) */
  .blog-content-bg .blog-search-results > article a.btn {
    display: none !important;
  }

  /* O link absolute existente (data-post-link sobre a imagem) já cobre o card;
     garante que cobre o card todo, não só a imagem */
  .blog-content-bg .blog-search-results > article > div:first-child > a[data-post-link] {
    position: absolute;
    inset: 0;
    z-index: 10;
  }

  /* ── Paginação (Anterior / Próxima / números) ──────────────────── */
  .blog-content-bg #pagination {
    margin-top: 3rem;
    padding: 0 20px;
  }
  .blog-content-bg #pagination a,
  .blog-content-bg #pagination span {
    background-color: rgba(255, 255, 255, 0.06) !important;
    border: 1px solid rgba(225, 255, 165, 0.15) !important;
    color: #f5f5f5 !important;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .blog-content-bg #pagination a:hover {
    background-color: #b4fa50 !important;
    color: #002d3c !important;
    border-color: #b4fa50 !important;
  }
  .blog-content-bg #pagination [aria-current="page"] {
    background-color: #b4fa50 !important;
    color: #002d3c !important;
    border-color: #b4fa50 !important;
  }
</style>
